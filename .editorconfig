# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# cmd.exe needs CRLF to find labels reliably.
[*.{cmd,bat}]
end_of_line = crlf

[*.{css,html}]
indent_size = 2

[server/public/*.js]
indent_size = 2

[*.{json,jsonc}]
indent_size = unset

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
